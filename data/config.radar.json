{
  "ai": {
    "provider": "openai",
    "model": "sensenova-6.8-flash",
    "api_key_env": "SENSENOVA_API_KEY",
    "languages": [
      "zh"
    ],
    "temperature": 0.2,
    "max_tokens": 1024,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "base_url": "https://token.sensenova.cn/v1",
    "fallback_models": [
      "deepseek-flash",
      "deepseek-v4-flash",
      "glm-5.3",
      "glm-5.2",
      "kimi-k3"
    ],
    "json_response_format": false,
    "request_timeout_sec": 25,
    "request_max_retries": 0
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "radar-platform",
    "profile_settings": {
      "radar-token": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "radar-compute": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "radar-router": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "radar-platform": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "radar-policy": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
